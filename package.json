{
  "name": "openbento-next",
  "private": true,
  "description": "OpenBento-Next monorepo — AI-native live intelligence canvas",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": "22.23.x"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint && eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter web exec next typegen && pnpm --filter web exec tsc --noEmit",
    "test": "vitest run",
    "eval:terra-compare": "pnpm --filter @openbento/watchbot eval:terra-compare"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
