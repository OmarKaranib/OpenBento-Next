# Public placeholders only. Never commit secrets.
# Hosted **dev** Supabase (org: openbento, region us-east-1). Not production.
# Platform applies reviewed migrations. Do not apply SQL from this checkout.

NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
# Legacy alias accepted by the client factory:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Worker-only. Never NEXT_PUBLIC. Never commit a real value. Never print it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional WatchBot Grok adapter (unused in default tests). Never commit real keys.
XAI_API_KEY=
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-fast-non-reasoning

# Optional official X API v2 WatchBot lane. Disabled by default; worker-only.
# Never set NEXT_PUBLIC_ equivalents and never commit a real bearer token.
X_PROVIDER_ENABLED=false
X_BEARER_TOKEN=
# Hard-bounded local controls (values above code caps are clamped).
X_MAX_RESULTS_PER_REQUEST=10
X_MAX_RESULTS_PER_CYCLE=10
X_MAX_PAGES_PER_CYCLE=1
X_MAX_REQUESTS_PER_CYCLE=1
X_PROVIDER_TIMEOUT_MS=10000
