# Public placeholders only. Never commit secrets.
# Hosted **dev** Supabase (org: openbento, region us-east-1). Not production.
# Platform applies reviewed migrations. Do not apply SQL from this checkout.

# --- Web ---
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
# Legacy alias accepted by the client factory:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin for Auth redirects. Placeholder until the Railway web URL exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Worker only. Never NEXT_PUBLIC. Never on the web runtime. Never commit a real value. ---
SUPABASE_SERVICE_ROLE_KEY=

# Fail closed: absent or anything other than true/1 means the loop does not run cycles.
OPENBENTO_WORKER_ENABLED=false

# When true/1 with worker enabled, run exactly one tick and exit (overrides --loop).
OPENBENTO_WORKER_RUN_ONCE=false

# Optional cycle interval in ms. Default 60000. Hard ceiling 300000.
OPENBENTO_WORKER_INTERVAL_MS=

# Optional WatchBot providers (names only; fail closed if missing). Never commit real keys.
XAI_API_KEY=
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-fast-non-reasoning

# Optional official X API v2 WatchBot lane. Disabled by default; worker-only.
# Never set NEXT_PUBLIC_ equivalents and never commit a real bearer token.
X_PROVIDER_ENABLED=false
X_BEARER_TOKEN=
# Hard-bounded local controls (values above code caps are clamped).
X_MAX_RESULTS_PER_REQUEST=10
X_MAX_RESULTS_PER_CYCLE=10
X_MAX_PAGES_PER_CYCLE=1
X_MAX_REQUESTS_PER_CYCLE=1
# Shared across all WatchBots in one worker tick (default 1, ceiling 10).
X_MAX_REQUESTS_PER_WORKER_TICK=1
X_PROVIDER_TIMEOUT_MS=10000

# Optional WatchBot meaning classifier (Slice E). Disabled by default; worker-only.
# Paid calls require ALL of:
#   WATCHBOT_MEANINGFULNESS_CLASSIFIER_ENABLED=true
#   WATCHBOT_MEANINGFULNESS_PROVIDER=openai|xai  (explicit; missing/empty/none → passthrough)
#   matching vendor key (OPENAI_API_KEY for openai, XAI_API_KEY/GROK_API_KEY for xai)
# Never auto-picks a vendor from which key is present. No silent cross-fallback.
WATCHBOT_MEANINGFULNESS_CLASSIFIER_ENABLED=false
WATCHBOT_MEANINGFULNESS_PROVIDER=none
WATCHBOT_MEANINGFULNESS_MAX_CALLS_PER_TICK=5
WATCHBOT_MEANINGFULNESS_MAX_CALLS_PER_CYCLE=5
WATCHBOT_MEANINGFULNESS_TIMEOUT_MS=8000
# OpenAI adapter (worker-only). Never commit a real key. Never NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MEANINGFULNESS_MODEL=gpt-5.6-luna
